{
	"permissions": {
		"allow": [
			"Bash(pnpm install)",
			"Bash(pnpm test)",
			"Bash(pnpm run check)",
			"Bash(pnpm run check:watch)",
			"Bash(pnpm run lint)",
			"Bash(pnpm run format)",
			"Bash(pnpm run gates)",
			"Bash(pnpm run feedback *)",
			"Bash(pnpm run quick)",
			"Bash(pnpm run test:unit *)",
			"Bash(pnpm run test:e2e *)",
			"Bash(pnpm run build)",
			"Bash(pnpm run budget)",
			"Bash(pnpm exec svelte-kit sync)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git show *)",
			"Bash(git branch *)",
			"Bash(ls *)",
			"Bash(wc *)",
			"Bash(find *)",
			"Bash(head *)",
			"Bash(tail *)",
			"Bash(sed -n *)"
		],
		"deny": ["Read(./pnpm-lock.yaml)"]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	}
}
