{
	"name": "visus",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gates": "bash scripts/gates.sh",
		"feedback": "bash scripts/feedback.sh",
		"quick": "pnpm run gates && pnpm run check && pnpm run test:unit --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "pnpm run gates && pnpm run check && pnpm run lint && pnpm run test:unit --run && pnpm run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@types/three": "^0.186.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"iwer": "^2.7.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"description": "View 3D models in a Meta Quest: walk through them, change scale, jump between cameras, leave notes.",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"three": "^0.186.1"
	}
}
