{
	"name": "visus",
	"private": true,
	"version": "0.2.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "bash scripts/decoders.sh && node scripts/xr-assets.mjs && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gates": "bash scripts/gates.sh",
		"feedback": "bash scripts/feedback.sh",
		"quick": "pnpm run gates && pnpm run check && pnpm run test:unit --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "pnpm run gates && pnpm run check && pnpm run lint && pnpm run test:unit --run && pnpm run test:e2e",
		"fixtures": "node scripts/fixtures.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@gltf-transform/cli": "^4.5.1",
		"@ibm/plex-sans": "^1.1.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@types/three": "^0.186.0",
		"@webxr-input-profiles/assets": "^1.0.20",
		"draco3dgltf": "^1.5.9",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"iwer": "^2.7.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"description": "View 3D models in a Meta Quest: walk through them, change scale, jump between cameras, leave notes.",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@carbon/icons": "^11.91.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@pmndrs/uikit": "^1.0.77",
		"@pmndrs/xr": "^6.6.32",
		"@sparkjsdev/spark": "^2.4.0",
		"bits-ui": "^2.20.2",
		"camera-controls": "^3.1.2",
		"idb-keyval": "^6.3.0",
		"meshoptimizer": "^1.3.0",
		"three": "^0.186.1",
		"three-mesh-bvh": "^0.9.16",
		"valibot": "^1.5.0",
		"yjs": "^13.6.33"
	}
}
